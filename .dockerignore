# Docker ignore file for BAZAR Marketplace
# Optimizes build context and reduces image size

# Git
.git
.gitignore
.gitattributes

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Maven
target/
!target/*.jar
.mvn/wrapper/maven-wrapper.jar

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp

# Documentation
*.md
!README.md
docs/

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
Jenkinsfile

# Environment files
.env
.env.local
.env.*.local

# Test files
src/test/
test-reports/

# Build artifacts
build/
dist/

# Node modules (if any)
node_modules/

# Certificates and keys
*.pem
*.key
*.crt
*.p12
keystore.*

# Backup files
*.bak
*.backup

# Cache directories
.cache/
.npm/
.yarn/

# Coverage reports
coverage/
*.coverage
