# BAZAR Marketplace - Global .gitignore

# ========================================
# FLUTTER / MOBILE APP
# ========================================
# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Web related
lib/generated_plugin_registrant.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ========================================
# BACKEND / LARAVEL
# ========================================
# Laravel specific
.env
.env.testing
.env.local
.env.production
.env.staging

# Composer
/vendor/
composer.lock

# Node modules
/node_modules/
npm-debug.log
package-lock.json
yarn.lock
yarn-error.log

# IDE
.idea/
.vscode/
.php_cs.cache
.phpunit.result.cache
.vagrant/
Homestead.json
Homestead.yaml

# Storage
/storage/*.key
/storage/dcc-data/
/storage/logs/
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/views/

# Public assets
/public/css/
/public/js/
/public/hot/
/public/storage/
/public/vendor/

# ========================================
# GENERAL
# ========================================
# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# ========================================
# BAZAR SPECIFIC
# ========================================
# Build artifacts
/build/
/dist/
/out/

# Test results
/test-results/
/playwright-report/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Database
*.sqlite
*.db

# Backup files
*.bak
*.backup

# ========================================
# SECURITY
# ========================================
# Never commit sensitive files
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/

# ========================================
# DOCUMENTATION
# ========================================
# Keep documentation but ignore generated files
/docs/build/
/docs/.docusaurus/
